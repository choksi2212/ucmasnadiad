# Copy to ".env.local" and fill in. Never commit .env.local.

# Cloudinary — required for images AND for Results & Achievements (server lists assets via Admin API).
# On Vercel, add all three; without API key + secret, results albums only work from local public/RESULTS fallback.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Web3Forms — required for the footer contact form (submits from the browser; key is public by design).
# Copy the access key from https://web3forms.com — same value you use in Web3Forms dashboard.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Optional: only if you use Web3Forms Pro and whitelist your server IP for POST /api/contact
# WEB3FORMS_ACCESS_KEY=

# Optional: canonical site URL for /api/contact Origin checks (include https, no trailing slash)
# NEXT_PUBLIC_SITE_URL=https://rdabacuznadiad.com
